{
  "name": "scrcpy-desktop",
  "version": "1.0.0",
  "description": "Desktop UI for scrcpy - live device status, history, one-click mirroring",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Md Raihan Hasan (ryn.bd)",
  "license": "MIT",
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "bd.ryn.scrcpydesktop",
    "productName": "scrcpy Desktop",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "scrcpy-Desktop-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "scrcpy-Desktop-portable-${version}.exe"
    },
    "extraResources": [
      {
        "from": "vendor/scrcpy-win64",
        "to": "scrcpy-win64",
        "filter": [
          "**/*"
        ]
      }
    ],
    "copyright": "Copyright (c) Md Raihan Hasan - ryn.bd"
  },
  "homepage": "https://ryn.bd"
}